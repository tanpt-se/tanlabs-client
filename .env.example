# Optional — defaults to /api (Worker proxy to tanlabs-api)
# VITE_API_BASE=/api

# Google OAuth on login/register pages (requires tanlabs-api Google OAuth config)
# VITE_AUTH_GOOGLE_ENABLED=true

# Cloudflare Turnstile (required in production when API validates captcha)
# VITE_TURNSTILE_SITE_KEY=1x0000000000000000000000000000000AA

# CSRF (must match tanlabs-api AUTH_CSRF_PROTECTION_ENABLED)
# VITE_AUTH_CSRF_PROTECTION_ENABLED=false

# Session watchdog interval (ms)
# VITE_SESSION_WATCHDOG_INTERVAL_MS=10000

# Max active sessions hint for UI
# VITE_MAX_ACTIVE_SESSIONS=2
